{
    "schemaVersion": 1,
    "id": "structure_editor",
    "version": "${version}",
    "name": "Structure Editor",
    "description": "MCP bridge for reading and editing jigsaw and structure block data in-world.",
    "authors": [
        "finndog"
    ],
    "contact": {},
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.finndog.structure_editor.StructureEditorMod"
        ],
        "client": [
            "com.finndog.structure_editor.client.StructureEditorClient"
        ]
    },
    "mixins": [
        "structure_editor.mixins.json",
        {
            "config": "structure_editor.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    }
}
